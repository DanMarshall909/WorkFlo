# WorkFlo Environment Variables Template
# Copy this file to .env and update with your actual values
# NEVER commit .env files to version control

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=WorkFloDb
DB_USERNAME=workflo_app
DB_PASSWORD=your_secure_database_password

# Analytics Database (optional)
ANALYTICS_DB_USERNAME=workflo_analytics
ANALYTICS_DB_PASSWORD=your_analytics_password

# JWT Authentication
JWT_SECRET=your_super_secure_jwt_secret_at_least_32_characters_long
JWT_ISSUER=WorkFlo
JWT_AUDIENCE=WorkFlo

# External API Keys
OPENAI_API_KEY=sk-your-openai-api-key-here
GITHUB_PAT=ghp_your_github_personal_access_token

# Logging Configuration
SEQ_SERVER_URL=http://localhost:5341
SEQ_API_KEY=your_seq_api_key

# Email Service (if used)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_email_password

# Cloud Services (if used)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AZURE_CONNECTION_STRING=your_azure_connection_string

# Development Settings
ASPNETCORE_ENVIRONMENT=Development
USE_IN_MEMORY_DATABASE=true
ENABLE_SWAGGER=true

# Security Settings
CORS_ORIGINS=http://localhost:3000,https://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1

# WorkFlo Specific
WORKFLO_API_PORT=5000
WORKFLO_HOOKS_ENABLED=true
WORKFLO_TDD_ENFORCEMENT=true

# Third-party Integrations
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Development Tools
HOT_RELOAD_ENABLED=true
DEBUG_MODE=true