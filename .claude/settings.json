{
  "hooks": {
    "session-start-hook": "/home/dan/code/WorkFlo/.claude/workflo-automation-hook.sh",
    "user-prompt-submit-hook": "/home/dan/.claude/github-automation-reminder.sh"
  },
  "permissions": {
    "inherit_global": true,
    "additional_deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)", 
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git checkout -b:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh issue create:*)"
    ],
    "additional_allow": [
      "Bash(flo:*)",
      "Bash(./flo:*)",
      "Bash(flo-cli/dist/cli.js:*)",
      "Bash(node flo-cli/dist/cli.js:*)"
    ]
  },
  "project_rules": {
    "github_automation_enforcement": {
      "enabled": true,
      "strict_mode": true,
      "reminder_frequency": "every_session",
      "policy_document": "AI_GUIDELINES.md"
    }
  },
  "notifications": {
    "github_command_blocked": {
      "enabled": true,
      "message": "🚫 Blocked: Use flo automation instead. See workflo-automation-hook.sh for available commands.",
      "show_alternatives": true
    }
  }
}