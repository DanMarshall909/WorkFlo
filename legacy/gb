#!/bin/bash
# gb - GitHub Board Bridge Script
# Bridges ./gb calls to GitHub Board Sync script for dogfooding
# This enables the wf script to call ./gb while using existing board management

set -euo pipefail

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Check if we're in the WorkFlo project directory
if [[ ! -f "WorkFlo.sln" ]]; then
    echo "❌ Error: Must be run from WorkFlo project root directory" >&2
    exit 1
fi

# Print bridge info
echo -e "${BLUE}📋 WorkFlo GitHub Board Management${NC}"
echo -e "${BLUE}Bridge: ./gb → scripts/github/gh-board-sync.sh${NC}"
echo ""

# Check if the target script exists
BOARD_SCRIPT="./scripts/github/gh-board-sync.sh"
if [[ ! -f "$BOARD_SCRIPT" ]]; then
    echo "❌ Error: Board sync script not found at $BOARD_SCRIPT" >&2
    exit 1
fi

# Execute the board sync script with all arguments
"$BOARD_SCRIPT" "$@"

# Capture the exit code to pass through
exit_code=$?

# Show completion message
if [[ $exit_code -eq 0 ]]; then
    echo ""
    echo -e "${GREEN}✅ GitHub board operation completed${NC}"
else
    echo ""
    echo "❌ GitHub board operation failed"
fi

exit $exit_code