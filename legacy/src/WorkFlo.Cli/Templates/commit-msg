#!/bin/sh
# WorkFlo commit-msg hook
# Validates commit message format using HTTP API

# Configuration
API_PORT=${WORKFLO_API_PORT:-5000}
API_URL="http://localhost:${API_PORT}/api/validation/commit-msg"

# Start API if needed
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -f "${SCRIPT_DIR}/start-api-if-needed.sh" ]; then
    bash "${SCRIPT_DIR}/start-api-if-needed.sh"
    if [ $? -ne 0 ]; then
        echo "Failed to start WorkFlo API"
        exit 1
    fi
fi

# Get the commit message file path and read message
COMMIT_MSG_FILE="$1"
if [ ! -f "$COMMIT_MSG_FILE" ]; then
    echo "Error: Commit message file not found: $COMMIT_MSG_FILE"
    exit 1
fi

COMMIT_MESSAGE=$(cat "$COMMIT_MSG_FILE")

# Create JSON payload
JSON_PAYLOAD=$(cat <<EOF
{
  "commitMessage": $(echo "$COMMIT_MESSAGE" | jq -R -s .)
}
EOF
)

# Make HTTP request to API
RESPONSE=$(curl -s -X POST \
  -H "Content-Type: application/json" \
  -d "$JSON_PAYLOAD" \
  "$API_URL")

if [ $? -ne 0 ]; then
    echo "Error: Failed to connect to WorkFlo API at $API_URL"
    echo "Please ensure the API server is running or install WorkFlo CLI"
    exit 1
fi

# Parse response
IS_VALID=$(echo "$RESPONSE" | grep -o '"isValid":[^,}]*' | cut -d: -f2 | tr -d ' ')
ERRORS=$(echo "$RESPONSE" | grep -o '"errors":\[[^]]*\]' | cut -d: -f2-)

if [ "$IS_VALID" = "true" ]; then
    echo "✅ Commit message validation passed"
    exit 0
else
    echo "❌ Commit message validation failed:"
    echo "$ERRORS" | sed 's/\[//g; s/\]//g; s/"//g' | tr ',' '\n' | sed 's/^/  - /'
    exit 1
fi