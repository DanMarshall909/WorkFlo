#!/bin/bash
# Ultra-minimal board management for GitHub issues and subissues
# Uses GitHub CLI to manage GitHub Projects board automatically
# Integrates with tdd command for seamless workflow

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m' 
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

error() { echo -e "${RED}[ERROR]${NC} $1" >&2; exit 1; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
info() { echo -e "${BLUE}[INFO]${NC} $1"; }

# Check prerequisites
check_prereqs() {
    command -v gh >/dev/null || error "GitHub CLI required: https://cli.github.com/"
    command -v jq >/dev/null || error "jq required: sudo apt-get install jq"
    gh auth status >/dev/null || error "GitHub CLI not authenticated: gh auth login"
}

# Get or create WorkFlo project board
get_or_create_board() {
    local repo_owner=$(gh repo view --json owner | jq -r '.owner.login')
    
    # Check if WorkFlo board exists
    local project_id=$(gh project list --owner "$repo_owner" --format json | \
                      jq -r '.projects[] | select(.title == "WorkFlo TDD Board") | .id' | head -1)
    
    if [[ -z "$project_id" ]]; then
        info "Creating WorkFlo TDD Board..."
        
        # Create new project
        project_id=$(gh project create --title "WorkFlo TDD Board" --owner "$repo_owner" --format json | jq -r '.id')
        
        # Add custom fields for TDD tracking
        gh project field-create "$project_id" --name "TDD Phase" --type "single_select" \
           --single-select-option "Not Started" \
           --single-select-option "RED" \
           --single-select-option "GREEN" \
           --single-select-option "REFACTOR" \
           --single-select-option "COVER" \
           --single-select-option "Complete" >/dev/null 2>&1 || true
        
        gh project field-create "$project_id" --name "Criteria Progress" --type "text" >/dev/null 2>&1 || true
        
        success "Created WorkFlo TDD Board (ID: $project_id)"
    fi
    
    echo "$project_id"
}

# Add issue to board
add_to_board() {
    local issue_id=$1
    local project_id=$(get_or_create_board)
    
    # Add issue to project
    gh project item-add "$project_id" --url "$(gh issue view "$issue_id" --json url | jq -r '.url')" >/dev/null 2>&1 || true
    
    # Set initial TDD phase
    local item_id=$(gh project item-list "$project_id" --format json | \
                   jq -r --arg issue "$issue_id" '.items[] | select(.content.number == ($issue | tonumber)) | .id' | head -1)
    
    if [[ -n "$item_id" ]]; then
        gh project item-edit --id "$item_id" --field-id "TDD Phase" --single-select-option-id "Not Started" >/dev/null 2>&1 || true
    fi
}

# Update TDD phase on board
update_board_phase() {
    local issue_id=$1
    local phase=$2
    local criteria_progress="$3"
    
    local project_id=$(get_or_create_board)
    local item_id=$(gh project item-list "$project_id" --format json | \
                   jq -r --arg issue "$issue_id" '.items[] | select(.content.number == ($issue | tonumber)) | .id' | head -1)
    
    if [[ -n "$item_id" ]]; then
        gh project item-edit --id "$item_id" --field-id "TDD Phase" --single-select-option-id "$phase" >/dev/null 2>&1 || true
        [[ -n "$criteria_progress" ]] && \
            gh project item-edit --id "$item_id" --field-id "Criteria Progress" --text "$criteria_progress" >/dev/null 2>&1 || true
    fi
}

# Main commands
case "$1" in
    list)
        check_prereqs
        project_id=$(get_or_create_board)
        
        info "WorkFlo TDD Board"
        echo "================="
        echo ""
        
        # Show board URL
        repo_owner=$(gh repo view --json owner | jq -r '.owner.login')
        echo "🔗 Board URL: https://github.com/users/$repo_owner/projects/$(echo $project_id | tr -d 'PVT_')"
        echo ""
        
        # List items on board with TDD phases
        gh project item-list "$project_id" --format json | \
        jq -r '.items[] | select(.content.type == "Issue") | 
        "\(.content.number): \(.content.title) [\(.fieldValues.TDD_Phase // "Not Started")]"' | \
        while read -r line; do
            if [[ -n "$line" ]]; then
                echo "📋 Issue $line"
            fi
        done
        
        echo ""
        info "Use: board show <issue> to see acceptance criteria"
        info "Use: board create to create new issue with criteria"
        ;;
    
    show)
        check_prereqs
        ISSUE=$2
        [[ -z "$ISSUE" ]] && error "Usage: board show <issue_number>"
        
        info "Issue #$ISSUE Details"
        echo "===================="
        
        # Get issue details
        ISSUE_DATA=$(gh issue view "$ISSUE" --json title,body,state,labels)
        TITLE=$(echo "$ISSUE_DATA" | jq -r '.title')
        STATE=$(echo "$ISSUE_DATA" | jq -r '.state')
        BODY=$(echo "$ISSUE_DATA" | jq -r '.body')
        
        echo ""
        echo "📋 Title: $TITLE"
        echo "🏷️  State: $STATE"
        echo ""
        
        # Extract and display acceptance criteria
        info "Acceptance Criteria:"
        echo "$BODY" | grep -E '^- \[ \]' | nl -v1 -s'. ' | sed 's/^/  /'
        
        # Count criteria for tdd integration
        TOTAL=$(echo "$BODY" | grep -c '^- \[ \]' || echo 0)
        echo ""
        info "Total criteria: $TOTAL"
        
        if [[ $TOTAL -gt 0 ]]; then
            echo ""
            success "Ready for TDD workflow: ./tdd start $ISSUE"
        else
            warn "No acceptance criteria found. Use format: - [ ] criterion"
        fi
        ;;
    
    create)
        check_prereqs
        
        # Command line mode: board create --title "Title" --criteria "c1;c2;c3" --description "desc"
        if [[ "$2" == "--title" ]]; then
            title="$3"
            shift 3
            
            criteria_str=""
            description=""
            
            while [[ $# -gt 0 ]]; do
                case $1 in
                    --criteria) criteria_str="$2"; shift 2 ;;
                    --description) description="$2"; shift 2 ;;
                    *) error "Unknown option: $1" ;;
                esac
            done
            
            [[ -z "$title" ]] && error "Title is required"
            [[ -z "$criteria_str" ]] && error "At least one criterion is required (use --criteria 'c1;c2;c3')"
            
            # Parse criteria (semicolon separated)
            IFS=';' read -ra criteria <<< "$criteria_str"
            
        else
            # Interactive mode
            info "Creating new GitHub issue with acceptance criteria"
            echo ""
            
            read -p "Issue title: " title
            [[ -z "$title" ]] && error "Title is required"
            
            echo ""
            info "Enter acceptance criteria (one per line, empty line to finish):"
            info "Format: Each criterion should be a clear, testable requirement"
            echo ""
            
            criteria=()
            while true; do
                read -p "Criterion $((${#criteria[@]} + 1)): " criterion
                [[ -z "$criterion" ]] && break
                criteria+=("$criterion")
            done
            
            if [[ ${#criteria[@]} -eq 0 ]]; then
                error "At least one acceptance criterion is required"
            fi
            
            echo ""
            read -p "Issue description (optional): " description
        fi
        
        # Build issue body
        body="$description"
        [[ -n "$description" ]] && body="$body\n\n"
        body="${body}## Acceptance Criteria\n\n"
        
        for criterion in "${criteria[@]}"; do
            body="${body}- [ ] $criterion\n"
        done
        
        # Create the issue
        ISSUE_NUM=$(gh issue create --title "$title" --body "$(echo -e "$body")" | grep -o '#[0-9]*' | tr -d '#')
        
        # Add to board
        add_to_board "$ISSUE_NUM"
        
        success "Created issue #$ISSUE_NUM: $title"
        info "Added ${#criteria[@]} acceptance criteria"
        info "Added to WorkFlo TDD Board"
        echo ""
        success "Start TDD workflow: ./tdd start $ISSUE_NUM"
        ;;
    
    subissue)
        check_prereqs
        PARENT=$2
        [[ -z "$PARENT" ]] && error "Usage: board subissue <parent_issue>"
        
        info "Creating subissue for #$PARENT"
        
        # Get parent issue title for context
        PARENT_TITLE=$(gh issue view "$PARENT" --json title | jq -r '.title')
        
        echo ""
        echo "Parent: #$PARENT - $PARENT_TITLE"
        echo ""
        
        read -p "Subissue title: " title
        [[ -z "$title" ]] && error "Title is required"
        
        read -p "Subissue description: " description
        
        # Create subissue with parent reference
        body="Subissue of #$PARENT\n\n$description\n\n## Acceptance Criteria\n\n"
        
        echo ""
        info "Enter acceptance criteria for this subissue:"
        criteria=()
        while true; do
            read -p "Criterion $((${#criteria[@]} + 1)): " criterion
            [[ -z "$criterion" ]] && break
            criteria+=("$criterion")
        done
        
        for criterion in "${criteria[@]}"; do
            body="${body}- [ ] $criterion\n"
        done
        
        # Create subissue with labels
        SUBISSUE_NUM=$(gh issue create \
            --title "[$PARENT] $title" \
            --body "$(echo -e "$body")" \
            --label "subissue" | \
            grep -o '#[0-9]*' | tr -d '#')
        
        # Add to board
        add_to_board "$SUBISSUE_NUM"
        
        success "Created subissue #$SUBISSUE_NUM"
        info "Added to WorkFlo TDD Board"
        
        # Add comment to parent issue
        gh issue comment "$PARENT" --body "Created subissue #$SUBISSUE_NUM: $title"
        
        echo ""
        success "Start TDD on subissue: ./tdd start $SUBISSUE_NUM"
        ;;
    
    status)
        check_prereqs
        info "Board Status Overview"
        echo "===================="
        echo ""
        
        # Count issues by state
        OPEN=$(gh issue list --state open --json number | jq '. | length')
        CLOSED=$(gh issue list --state closed --limit 50 --json number | jq '. | length')
        
        echo "📊 Issues: $OPEN open, $CLOSED recently closed"
        echo ""
        
        # Show issues with acceptance criteria
        info "Issues with acceptance criteria (TDD-ready):"
        gh issue list --state open --json number,title,body | \
        jq -r '.[] | select(.body | test("- \\[ \\]")) | 
        "\(.number): \(.title)"' | \
        head -10 | \
        while read -r line; do
            if [[ -n "$line" ]]; then
                echo "  📋 Issue $line"
            fi
        done
        
        echo ""
        info "Use: board list - see all issues"
        info "Use: board show <issue> - see issue details"
        info "Use: board create - create new issue"
        ;;
    
    complete)
        check_prereqs
        ISSUE=$2
        [[ -z "$ISSUE" ]] && error "Usage: board complete <issue_number>"
        
        info "Completing issue #$ISSUE"
        
        # Update board phase to Complete
        update_board_phase "$ISSUE" "Complete" "All criteria completed"
        
        # Close the issue
        gh issue close "$ISSUE" --comment "Completed via TDD workflow"
        
        success "Issue #$ISSUE marked as complete"
        info "Updated on WorkFlo TDD Board"
        
        # Check if this was a subissue and update parent
        ISSUE_BODY=$(gh issue view "$ISSUE" --json body | jq -r '.body')
        PARENT_REF=$(echo "$ISSUE_BODY" | grep -o 'Subissue of #[0-9]*' | grep -o '#[0-9]*' | tr -d '#')
        
        if [[ -n "$PARENT_REF" ]]; then
            info "Updating parent issue #$PARENT_REF"
            gh issue comment "$PARENT_REF" --body "✅ Completed subissue #$ISSUE"
        fi
        ;;
    
    help|--help|-h)
        echo "Ultra-Minimal Board Management for GitHub Issues"
        echo ""
        echo "Usage: board {list|show|create|subissue|status|complete|help}"
        echo ""
        echo "Commands:"
        echo "  list                 List all open issues with acceptance criteria"
        echo "  show ISSUE          Show issue details and acceptance criteria"
        echo "  create              Create new issue with acceptance criteria (interactive)"
        echo "  create --title 'Title' --criteria 'c1;c2;c3' [--description 'desc']"
        echo "                       Create issue via command line"
        echo "  subissue PARENT     Create subissue under parent issue"
        echo "  status              Show board overview and statistics"
        echo "  complete ISSUE      Mark issue as complete and close"
        echo "  help                Show this help message"
        echo ""
        echo "Integration with TDD:"
        echo "  • Issues must have acceptance criteria format: - [ ] criterion"
        echo "  • Use 'board show <issue>' before 'tdd start <issue>'"
        echo "  • Use 'board complete <issue>' after TDD workflow"
        echo ""
        echo "Subissue workflow:"
        echo "  • Create subissues for complex features"
        echo "  • Each subissue has its own acceptance criteria"
        echo "  • Parent issues are automatically updated"
        ;;
    
    *)
        error "Unknown command: $1. Use 'board help' for usage information"
        ;;
esac