    <Compile Include="Core.fs" />
    <Compile Include="AsyncCore.fs" />
    <Compile Include="Computation.fs" />
    <Compile Include="Advanced.fs" />
    <Compile Include="Commands.fs" />
    
    <!-- Refactored modules with best practices -->
    <Compile Include="Domain.fs" />
    <Compile Include="Railway.fs" />
    <Compile Include="CoreServices.fs" />
    <Compile Include="Analytics.fs" />
    <Compile Include="ProgramRefactored.fs" />
  </ItemGroup>

</Project>
