#!/bin/bash
# Test runner script for WorkFlo TDD workflow
# Uses BATS for bash script testing, compatible with TDD script expectations

set -e

# Check if we're working on Issue #250 (flo-cli auto subcommand)
if [[ -f ".tdd-state" ]] && grep -q "ISSUE=250" ".tdd-state"; then
    echo "Issue #250 detected: Running flo-cli tests only"
    cd flo-cli && npm test -- --testPathPatterns=auto-subcommand
    exit $?
fi

# Check if BATS is available, fallback to shell script tests
USE_BATS=true
if ! command -v bats >/dev/null 2>&1; then
    echo "Warning: BATS not found. Using shell script test fallback." >&2
    USE_BATS=false
fi

# Find test files
find_test_files() {
    local test_files=()
    
    # Look for .bats files in tests/ directory and current directory
    if [[ -d "tests" ]]; then
        while IFS= read -r -d '' file; do
            test_files+=("$file")
        done < <(find tests -name "*.bats" -type f -print0 2>/dev/null)
    fi
    
    # Look for .bats files in current directory
    while IFS= read -r -d '' file; do
        test_files+=("$file")
    done < <(find . -maxdepth 1 -name "*.bats" -type f -print0 2>/dev/null)
    
    # Remove duplicates and print
    if [[ ${#test_files[@]} -gt 0 ]]; then
        printf '%s\n' "${test_files[@]}" | sort -u
    fi
}

# Main execution
case "${1:-}" in
    --help|-h)
        echo "Test Runner for WorkFlo TDD (using BATS)"
        echo ""
        echo "Usage: $0 [options] [test-files...]"
        echo ""
        echo "Options:"
        echo "  --help, -h     Show this help message"
        echo "  --list, -l     List discovered test files"
        echo ""
        echo "If no test files specified, auto-discovers *.bats files"
        echo "in tests/ directory and current directory."
        exit 0
        ;;
    --list|-l)
        echo "Discovered test files:"
        find_test_files | while read -r file; do
            echo "  $file"
        done
        exit 0
        ;;
    *)
        # If arguments provided, use them as test files, otherwise auto-discover
        if [[ $# -gt 0 ]]; then
            exec bats "$@"
        else
            if [[ "$USE_BATS" == "true" ]]; then
                test_files=($(find_test_files))
                if [[ ${#test_files[@]} -eq 0 ]]; then
                    echo "No .bats test files found in tests/ or current directory" >&2
                    echo "Create test files with .bats extension" >&2
                    exit 1
                fi
                exec bats "${test_files[@]}"
            else
                # Fallback to shell script tests
                if [[ -d "test" ]] && ls test/test-*.sh >/dev/null 2>&1; then
                    echo "Running shell script tests..."
                    for test_file in test/test-*.sh; do
                        echo "Running: $test_file"
                        bash "$test_file"
                    done
                else
                    echo "No test files found (looking for test/test-*.sh)" >&2
                    exit 1
                fi
            fi
        fi
        ;;
esac


# Run custom script tests (disabled during TDD RED/GREEN phases)
if [[ "${TDD_SKIP_SCRIPT_TESTS:-}" != "1" ]]; then
    echo "Running custom script tests..."
    ./test-flo-tdd-integration.sh
    ./test-cover-phase.sh
    ./test-cover-phase-edge-cases.sh
    ./test-refactor-phase.sh
    ./test-code-modification.sh
    ./test-validation.sh
    # ./test-meaningful-work-validation.sh # Temporarily disabled due to hang
fi