#!/bin/bash
# Test runner for WorkFlo .NET project
cd "$(dirname "$0")"

# Set test mode to avoid real AI calls during testing
export TDD_TEST_MODE=1

# Handle command line arguments for specific test types
case "${1:-}" in
    --help|-h)
        echo "Test Runner for WorkFlo TDD"
        echo ""
        echo "Usage: $0 [options]"
        echo ""
        echo "Options:"
        echo "  --help, -h     Show this help message"
        echo "  --bats-only    Run only BATS tests"
        echo "  --dotnet-only  Run only .NET tests"
        echo "  --bash-only    Run only bash script tests"
        echo "  --integration  Run integration tests (requires GitHub auth)"
        echo ""
        echo "Default: Run all test types"
        exit 0
        ;;
    --bats-only)
        if command -v bats >/dev/null 2>&1; then
            echo "Running BATS tests..."
            test_files=()
            if [[ -d "tests" ]]; then
                while IFS= read -r -d '' file; do
                    test_files+=("$file")
                done < <(find tests -name "*.bats" -type f -print0 2>/dev/null)
            fi
            while IFS= read -r -d '' file; do
                # Skip integration tests unless explicitly requested
                if [[ "$file" == *"integration"* ]] && [[ "${INCLUDE_INTEGRATION_TESTS:-}" != "1" ]]; then
                    continue
                fi
                test_files+=("$file")
            done < <(find . -maxdepth 1 -name "*.bats" -type f -print0 2>/dev/null)
            
            if [[ ${#test_files[@]} -gt 0 ]]; then
                bats "${test_files[@]}"
            else
                echo "No BATS test files found"
                exit 1
            fi
        else
            echo "BATS not available"
            exit 1
        fi
        exit 0
        ;;
    --dotnet-only)
        echo "Running .NET tests..."
        dotnet test src/WorkFlo.Core/tests/WorkFlo.Core.Tests/
        exit $?
        ;;
    --bash-only)
        if [[ "${TDD_SKIP_SCRIPT_TESTS:-}" != "1" ]]; then
            echo "Running custom script tests..."
            ./test-flo-tdd-integration.sh
        fi
        exit 0
        ;;
    --integration)
        echo "Running integration tests (requires GitHub auth)..."
        export INCLUDE_INTEGRATION_TESTS=1
        if command -v bats >/dev/null 2>&1; then
            if [[ -f "test-flo-integration.bats" ]]; then
                bats test-flo-integration.bats
            else
                echo "No integration test file found"
                exit 1
            fi
        else
            echo "BATS not available"
            exit 1
        fi
        exit 0
        ;;
esac

# Run all tests by default
echo "Running all WorkFlo tests..."

# 1. Run BATS tests if available
if command -v bats >/dev/null 2>&1; then
    echo "Running BATS tests..."
    test_files=()
    if [[ -d "tests" ]]; then
        while IFS= read -r -d '' file; do
            test_files+=("$file")
        done < <(find tests -name "*.bats" -type f -print0 2>/dev/null)
    fi
    while IFS= read -r -d '' file; do
        # Skip integration tests unless explicitly requested
        if [[ "$file" == *"integration"* ]] && [[ "${INCLUDE_INTEGRATION_TESTS:-}" != "1" ]]; then
            continue
        fi
        test_files+=("$file")
    done < <(find . -maxdepth 1 -name "*.bats" -type f -print0 2>/dev/null)
    
    if [[ ${#test_files[@]} -gt 0 ]]; then
        if ! bats "${test_files[@]}"; then
            echo "❌ BATS tests failed (continuing with other tests)"
            BATS_FAILED=1
        else
            echo "✅ BATS tests passed"
            BATS_FAILED=0
        fi
    else
        echo "No BATS test files found"
        BATS_FAILED=0
    fi
else
    echo "BATS not available, skipping BATS tests"
fi

# Run .NET tests
echo "Running .NET tests..."
if ! dotnet test src/WorkFlo.Core/tests/WorkFlo.Core.Tests/; then
    echo "❌ .NET tests failed"
    DOTNET_FAILED=1
else
    echo "✅ .NET tests passed"
    DOTNET_FAILED=0
fi

# Run custom script tests (disabled during TDD RED/GREEN phases)
if [[ "${TDD_SKIP_SCRIPT_TESTS:-}" != "1" ]]; then
    echo "Running custom script tests..."
    if ! ./test-flo-tdd-integration.sh; then
        echo "❌ Bash script tests failed"
        BASH_FAILED=1
    else
        echo "✅ Bash script tests passed"
        BASH_FAILED=0
    fi
    # ./test-meaningful-work-validation.sh # Temporarily disabled due to hang
else
    BASH_FAILED=0
fi

# Summary and exit
echo ""
echo "=== Test Summary ==="
if [[ "${BATS_FAILED:-0}" -eq 0 ]]; then
    echo "✅ BATS tests: PASSED"
else
    echo "❌ BATS tests: FAILED"
fi

if [[ "${DOTNET_FAILED:-0}" -eq 0 ]]; then
    echo "✅ .NET tests: PASSED"
else
    echo "❌ .NET tests: FAILED"
fi

if [[ "${BASH_FAILED:-0}" -eq 0 ]]; then
    echo "✅ Bash script tests: PASSED"
else
    echo "❌ Bash script tests: FAILED"
fi

# Exit with error if any test suite failed
if [[ "${BATS_FAILED:-0}" -eq 1 ]] || [[ "${DOTNET_FAILED:-0}" -eq 1 ]] || [[ "${BASH_FAILED:-0}" -eq 1 ]]; then
    echo ""
    echo "❌ Some tests failed"
    exit 1
else
    echo ""
    echo "✅ All tests passed"
    exit 0
fi