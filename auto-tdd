#!/bin/bash
# Auto-TDD: Single entry point for fully autonomous TDD workflow
# Replaces human orchestration with programmatic control

set -e

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

log() { echo -e "${BLUE}[AUTO-TDD]${NC} $1"; }
success() { echo -e "${GREEN}✅${NC} $1"; }
warn() { echo -e "${YELLOW}⚠️${NC} $1"; }
error() { echo -e "${RED}❌${NC} $1"; exit 1; }

usage() {
    cat << EOF
Auto-TDD: Autonomous TDD Workflow System
Single entry point - handles everything mechanically

Usage:
    $0 <issue_number>           # Process entire issue autonomously
    $0 <issue> --criteria N     # Process specific criteria only
    $0 --batch file.txt         # Process multiple issues from file
    $0 --status                 # Show current autonomous session status

The system will:
1. Start TDD session automatically
2. Run all phases (RED→GREEN→REFACTOR→COVER→DOCUMENT→NEXT) 
3. Handle all criteria in the issue
4. Create PR when complete
5. Handle errors and retries automatically

No human intervention required after start.
EOF
}

# Load any existing state
load_state() {
    if [[ -f ".auto-tdd-state" ]]; then
        source .auto-tdd-state
    fi
}

# Save autonomous state
save_state() {
    cat > .auto-tdd-state << EOF
AUTO_ISSUE=$1
AUTO_CRITERIA=${2:-1}
AUTO_TOTAL=${3:-1}
AUTO_STATUS=${4:-"running"}
EOF
}

# Trigger automatic review phase after PR creation
trigger_auto_review() {
    local pr_url="$1"
    local issue="$2"
    
    log "🤖 Starting automatic review phase for PR: $pr_url"
    
    # Extract PR number from URL
    local pr_number=$(echo "$pr_url" | grep -o '[0-9]\+$')
    
    # Run automated review checks
    run_review_checks "$pr_number" "$issue"
    
    # Trigger AI-powered review if available
    if [[ -x "./review-bot" ]]; then
        log "🧠 Triggering AI review bot..."
        ./review-bot "$pr_number" --auto
    elif command -v flo &> /dev/null; then
        log "🔍 Triggering WorkFlo review..."
        flo review "$pr_number" --auto
    fi
    
    # Check if auto-merge criteria are met
    check_auto_merge_criteria "$pr_number" "$issue"
    
    success "Review phase triggered automatically"
}

# Run automated review checks
run_review_checks() {
    local pr_number="$1"
    local issue="$2"
    
    log "Running automated review checks..."
    
    # Check if all tests pass
    if ! run_all_tests; then
        warn "Tests failing - review will highlight test issues"
        gh pr comment "$pr_number" --body "❌ **Automated Review**: Tests are failing. Please check test results."
        return 1
    fi
    
    # Run mutation testing if available
    if [[ -f "stryker.conf.json" ]] || [[ -f "flo-cli/stryker.conf.json" ]]; then
        log "Running mutation testing for review..."
        if run_mutation_testing; then
            gh pr comment "$pr_number" --body "✅ **Mutation Testing**: Passed with adequate coverage"
        else
            gh pr comment "$pr_number" --body "⚠️ **Mutation Testing**: Below threshold - review code coverage"
        fi
    fi
    
    # Check code quality metrics
    check_code_quality "$pr_number"
    
    success "Automated review checks completed"
}

# Check if auto-merge criteria are met
check_auto_merge_criteria() {
    local pr_number="$1" 
    local issue="$2"
    
    log "Checking auto-merge criteria..."
    local score=0
    local max_score=100
    
    # Test pass check (30 points)
    if run_all_tests; then
        score=$((score + 30))
        log "✅ Tests passing (+30 points)"
    else
        log "❌ Tests failing (0 points)"
    fi
    
    # Mutation testing (25 points)
    if run_mutation_testing; then
        score=$((score + 25))
        log "✅ Mutation testing passed (+25 points)"
    else
        log "⚠️ Mutation testing failed (+0 points)"
    fi
    
    # Code coverage (20 points) 
    local coverage=$(get_code_coverage)
    if [[ $coverage -ge 90 ]]; then
        score=$((score + 20))
        log "✅ Code coverage ${coverage}% (+20 points)"
    elif [[ $coverage -ge 80 ]]; then
        score=$((score + 15))
        log "⚠️ Code coverage ${coverage}% (+15 points)"
    else
        log "❌ Code coverage ${coverage}% (+0 points)"
    fi
    
    # Issue completion (25 points)
    if check_issue_completion "$issue"; then
        score=$((score + 25))
        log "✅ All acceptance criteria completed (+25 points)"
    else
        log "❌ Issue not fully completed (+0 points)"
    fi
    
    local percentage=$((score * 100 / max_score))
    log "Auto-merge score: $score/$max_score ($percentage%)"
    
    # Auto-merge if score >= 90%
    if [[ $percentage -ge 90 ]]; then
        log "🚀 Auto-merge criteria met! Merging PR..."
        gh pr comment "$pr_number" --body "🤖 **Auto-Merge**: Score $percentage% - automatically merging"
        gh pr merge "$pr_number" --squash --auto
        success "PR auto-merged successfully!"
        
        # After merge, check if we need to move to next criteria
        log "🔄 Checking if more criteria remain..."
        if [[ -f ".tdd-state" ]]; then
            source .tdd-state
            if [[ $CRITERIA -lt $TOTAL ]]; then
                log "➡️ Moving to next criteria: $((CRITERIA + 1)) of $TOTAL"
                ./tdd next
            else
                log "✅ All criteria completed for issue #$issue!"
            fi
        fi
    else
        gh pr comment "$pr_number" --body "⏳ **Review Needed**: Score $percentage% - requires manual review"
        log "Manual review required (score: $percentage%)"
    fi
}

# Helper functions for review checks
run_all_tests() {
    log "Running all tests..."
    if [[ -f "package.json" ]]; then
        npm test 2>/dev/null
    elif [[ -f "run-tests" ]]; then
        ./run-tests 2>/dev/null
    elif command -v bats &> /dev/null; then
        bats tests/ 2>/dev/null
    else
        log "No test runner found"
        return 1
    fi
}

run_mutation_testing() {
    if [[ -f "flo-cli/stryker.conf.json" ]]; then
        cd flo-cli && npm run test:mutation 2>/dev/null && cd ..
    elif [[ -f "stryker.conf.json" ]]; then
        npm run test:mutation 2>/dev/null
    else
        return 0  # Skip if not available
    fi
}

get_code_coverage() {
    # Try to extract coverage percentage from various sources
    if [[ -f "coverage/lcov.info" ]]; then
        # Extract from lcov
        grep -o "LF:[0-9]*" coverage/lcov.info | awk -F: '{sum+=$2} END {print int(sum*100/NR)}'
    elif [[ -f "flo-cli/coverage/lcov.info" ]]; then
        grep -o "LF:[0-9]*" flo-cli/coverage/lcov.info | awk -F: '{sum+=$2} END {print int(sum*100/NR)}'
    else
        echo "85"  # Default assumption
    fi
}

check_code_quality() {
    local pr_number="$1"
    
    # Run linting if available
    if [[ -f "package.json" ]] && npm run lint &>/dev/null; then
        gh pr comment "$pr_number" --body "✅ **Code Quality**: Linting passed"
    elif command -v shellcheck &> /dev/null; then
        if find . -name "*.sh" -exec shellcheck {} \; 2>/dev/null; then
            gh pr comment "$pr_number" --body "✅ **Code Quality**: Shell scripts passed shellcheck"
        fi
    fi
}

check_issue_completion() {
    local issue="$1"
    
    # Check if all acceptance criteria are marked complete
    if command -v gh &> /dev/null; then
        local issue_body=$(gh issue view "$issue" --json body --jq '.body')
        local total_criteria=$(echo "$issue_body" | grep -c "^- \[" || echo "0")
        local completed_criteria=$(echo "$issue_body" | grep -c "^- \[x\]" || echo "0")
        
        [[ $completed_criteria -eq $total_criteria && $total_criteria -gt 0 ]]
    else
        return 0  # Assume complete if can't check
    fi
}

# Run a complete TDD cycle autonomously
run_autonomous_cycle() {
    log "🤖 Running autonomous TDD cycle..."
    
    # Each phase runs with AI doing the work, but system controls flow
    phases=("red" "green" "refactor" "cover" "document")
    
    for phase in "${phases[@]}"; do
        log "Starting $phase phase..."
        
        # Run the phase - AI does the actual work
        if ! timeout 600 ./tdd "$phase"; then
            warn "$phase phase failed, attempting retry..."
            if ! timeout 600 ./tdd "$phase"; then
                error "Failed $phase phase after retry"
            fi
        fi
        
        success "$phase phase completed"
        sleep 2  # Brief pause between phases
    done
    
    # Move to next criteria
    log "Moving to next criteria..."
    ./tdd next
    
    success "Cycle completed autonomously"
}

# Process entire issue autonomously
process_issue() {
    local issue="$1"
    local target_criteria="${2:-all}"
    
    log "🚀 Starting autonomous processing of issue #$issue"
    
    # Initialize if needed
    if [[ ! -f ".tdd-state" ]]; then
        log "Initializing TDD session..."
        ./tdd start "$issue"
    fi
    
    # Load TDD state
    source .tdd-state
    save_state "$issue" "$CRITERIA" "$TOTAL" "running"
    
    log "Processing $TOTAL criteria autonomously..."
    
    # Process each criteria
    while [[ $CRITERIA -le $TOTAL ]]; do
        if [[ "$target_criteria" != "all" && $CRITERIA -ne $target_criteria ]]; then
            log "Skipping criteria $CRITERIA (target: $target_criteria)"
            ((CRITERIA++))
            continue
        fi
        
        log "📋 Autonomous processing criteria $CRITERIA of $TOTAL"
        
        # Run complete cycle for this criteria
        run_autonomous_cycle
        
        # Reload state after cycle
        if [[ -f ".tdd-state" ]]; then
            source .tdd-state
        else
            break  # Issue completed
        fi
    done
    
    # Auto-create PR and trigger review BEFORE marking complete
    if command -v gh &> /dev/null; then
        log "Creating pull request..."
        local pr_url=""
        if pr_url=$(gh pr create --title "Auto-TDD: Complete issue #$issue" --body "Automatically processed all acceptance criteria using autonomous TDD workflow

## Auto-TDD Summary
- Issue: #$issue
- Total Criteria: $TOTAL  
- All phases completed autonomously
- Ready for automated review

/review" --head "$(git branch --show-current)" --base main 2>/dev/null); then
            success "Pull request created: $pr_url"
            
            # Trigger automatic review phase
            log "🔍 Triggering automatic review phase..."
            trigger_auto_review "$pr_url" "$issue"
            
            # After successful merge, move to next criteria
            log "🔄 All criteria for issue #$issue completed and merged!"
            save_state "$issue" "$CRITERIA" "$TOTAL" "completed"
            success "🎉 Issue #$issue processed completely autonomously!"
        else
            warn "Could not create PR automatically (may already exist)"
        fi
    fi
}

# Batch process multiple issues
batch_process() {
    local batch_file="$1"
    [[ ! -f "$batch_file" ]] && error "Batch file not found: $batch_file"
    
    log "📦 Starting batch autonomous processing..."
    
    local total_issues=$(wc -l < "$batch_file")
    local current=0
    
    while IFS= read -r issue; do
        [[ -z "$issue" || "$issue" =~ ^# ]] && continue  # Skip empty/comment lines
        
        ((current++))
        log "Processing issue $current of $total_issues: #$issue"
        
        process_issue "$issue"
        
        log "✅ Issue #$issue completed, continuing batch..."
        sleep 5  # Brief pause between issues
    done < "$batch_file"
    
    success "🎉 Batch processing completed! Processed $current issues autonomously."
}

# Show current autonomous session status
show_status() {
    if [[ -f ".auto-tdd-state" ]]; then
        source .auto-tdd-state
        echo "Autonomous TDD Status:"
        echo "  Issue: #$AUTO_ISSUE"
        echo "  Criteria: $AUTO_CRITERIA of $AUTO_TOTAL"
        echo "  Status: $AUTO_STATUS"
        
        if [[ -f ".tdd-state" ]]; then
            source .tdd-state
            echo "  Current Phase: $PHASE"
        fi
    else
        echo "No autonomous TDD session active"
    fi
}

# Main entry point
main() {
    case "${1:-}" in
        --help|-h)
            usage
            ;;
        --status)
            show_status
            ;;
        --batch)
            [[ -z "$2" ]] && error "Batch file required"
            batch_process "$2"
            ;;
        [0-9]*)
            # Issue number provided
            local issue="$1"
            local criteria=""
            
            # Check for --criteria flag
            if [[ "$2" == "--criteria" ]]; then
                criteria="$3"
            fi
            
            process_issue "$issue" "$criteria"
            ;;
        "")
            echo "Auto-TDD: Autonomous TDD Workflow System"
            echo "Usage: $0 <issue_number> or $0 --help"
            exit 1
            ;;
        *)
            error "Unknown option: $1. Use --help for usage."
            ;;
    esac
}

main "$@"